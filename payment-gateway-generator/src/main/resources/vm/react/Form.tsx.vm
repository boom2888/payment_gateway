          },
          name: 'file',
          maxCount: 1,
          defaultFileList: uploadedFileList,
          onChange: handleUpload,
        }}
        placeholder="请上传${column.getViewColumnComment()}"
        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="请上传${column.getViewColumnComment()}！" />,
          },
        ]}
      />
      #else
      <ProFormText
        name="${column.javaField}"
        label={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}',
          defaultMessage: '${column.getViewColumnComment()}',
        })}
        placeholder={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}.placeholder',
          defaultMessage: '请上传${column.getViewColumnComment()}',
        })}
        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="${column.getViewColumnComment()}不能为空！" />,
          },
        ]}
      />
      #end
      </Col>
        #set($velocityCount = $velocityCount + 1)
        #if($velocityCount % 2 == 0)
        </Row>
        #end

      #end
      #end
      #end
    </DrawerForm>
  );
};

export default ${ClassName}Form;
