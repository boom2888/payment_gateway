        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="请选择${column.getViewColumnComment()}！" />,
          },
        ]}
      />
      #elseif($column.htmlType == 'datetime')
