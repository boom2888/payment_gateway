        extra={'需加盖公章'}
        placeholder={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}.placeholder',
          defaultMessage: '请上传${column.getViewColumnComment()}',
        })}
        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="请上传${column.getViewColumnComment()}！" />,
