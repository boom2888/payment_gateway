          id: '${moduleName}.${businessName}.${column.javaField}',
          defaultMessage: '${column.getViewColumnComment()}',
        })}
        placeholder="请选择${column.getViewColumnComment()}"
        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="请选择${column.getViewColumnComment()}！" />,
          },
        ]}
      />
      #elseif($column.htmlType == 'image')
      <ProFormUploadButton
        name="${column.javaField}"
        label={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}',
          defaultMessage: '${column.getViewColumnComment()}',
        })}
        valuePropName="file"
        fieldProps={{
          action: '/api/common/upload',
          headers: {
            Authorization: 'Bearer ' + localStorage.getItem('token'),
          },
          name: 'file',
          maxCount: 1,
          listType: 'picture-card',
          defaultFileList: uploadedFileList,
          onPreview: handlePreview,
