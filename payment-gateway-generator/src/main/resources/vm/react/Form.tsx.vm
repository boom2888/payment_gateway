        placeholder={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}.placeholder',
          defaultMessage: '请填写${column.getViewColumnComment()}',
        })}
        rules={[
          {
            required: ${column.required},
            message: <FormattedMessage id="${moduleName}.${businessName}.${column.javaField}.rule" defaultMessage="${column.getViewColumnComment()}不能为空！" />,
          },
        ]}
      />
      #end
      #if($column.insert && !$column.pk)
        #if($velocityCount % 2 == 0)
        <Row gutter={24}>
        #end
      <Col span={12}>
      #if($column.htmlType == 'input')
      <ProFormText
        name="${column.javaField}"
        label={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}',
          defaultMessage: '${column.getViewColumnComment()}',
        })}
        placeholder={intl.formatMessage({
          id: '${moduleName}.${businessName}.${column.javaField}.placeholder',
          defaultMessage: '请填写${column.getViewColumnComment()}',
