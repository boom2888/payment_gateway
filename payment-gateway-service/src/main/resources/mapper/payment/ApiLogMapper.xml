<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ApiLogMapper">

    <resultMap type="com.games.payment.domain.ApiLog" id="BaseResultMap">
        <result property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="ssoOrderId" column="sso_order_id"/>
        <result property="mobile" column="mobile"/>
        <result property="param" column="param"/>
        <result property="response" column="response"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="location" column="location"/>
        <result property="apiType" column="api_type"/>
        <result property="shopId" column="shop_id"/>
    </resultMap>


    <sql id="Base_Column_List">
        mt.id, mt.order_id, mt.sso_order_id, mt.mobile, mt.param, mt.response, mt.status, mt.create_by, mt.create_time, mt.update_by, mt.update_time, mt.remark, mt.location, mt.api_type, mt.shop_id    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ApiLog" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from api_log mt
        <where>

            <if test="id != null ">and mt.id = #{id}</if>
            <if test="orderId != null ">and mt.order_id = #{orderId}</if>
            <if test="ssoOrderId != null ">and mt.sso_order_id = #{ssoOrderId}</if>
            <if test="mobile != null  and mobile != ''">and mt.mobile = #{mobile}</if>
            <if test="param != null  and param != ''">and mt.param = #{param}</if>
            <if test="response != null  and response != ''">and mt.response = #{response}</if>
            <if test="status != null  and status != ''">and mt.status = #{status}</if>
            <if test="createBy != null  and createBy != ''">and mt.create_by = #{createBy}</if>
            <if test="createTime != null ">and mt.create_time = #{createTime}</if>
            <if test="updateBy != null  and updateBy != ''">and mt.update_by = #{updateBy}</if>
            <if test="updateTime != null ">and mt.update_time = #{updateTime}</if>
            <if test="remark != null  and remark != ''">and mt.remark = #{remark}</if>
            <if test="location != null  and location != ''">and mt.location = #{location}</if>
            <if test="apiType != null  and apiType != ''">and mt.api_type = #{apiType}</if>
            <if test="shopId != null ">and mt.shop_id = #{shopId}</if>
        </where>
        order by mt.id desc
    </select>

    <insert id="insertApiLog" parameterType="com.games.payment.domain.ApiLog" useGeneratedKeys="true" keyProperty="id">
        insert into api_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="mobile != null">mobile,</if>
            <if test="param != null">param,</if>
            <if test="responce != null">responce,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="location != null">location,</if>
            <if test="apiType != null">api_type,</if>
            <if test="shopId != null">shop_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="mobile != null">#{mobile},</if>
            <if test="param != null">#{param},</if>
            <if test="responce != null">#{responce},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="location != null">#{location},</if>
            <if test="apiType != null">#{apiType},</if>
            <if test="shopId != null">#{shopId},</if>
        </trim>
    </insert>

    <update id="updateApiLog" parameterType="com.games.payment.domain.ApiLog">
        update api_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="mobile != null">mobile = #{mobile},</if>
            <if test="param != null">param = #{param},</if>
            <if test="responce != null">responce = #{responce},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="location != null">location = #{location},</if>
            <if test="apiType != null">api_type = #{apiType},</if>
            <if test="shopId != null">shop_id = #{shopId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteApiLogById" parameterType="Long">
        delete
        from api_log
        where id = #{id}
    </delete>

    <delete id="deleteApiLogByIds" parameterType="String">
        delete from api_log where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>