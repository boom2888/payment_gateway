    <select id="selectAllList" parameterType="com.games.payment.domain.AuditLog" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from audit_log mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="auditEntityType != null "> and mt.audit_entity_type = #{auditEntityType}</if>
                                                                            <if test="entityId != null "> and mt.entity_id = #{entityId}</if>
                                                                            <if test="saasUserCorporationId != null "> and mt.saas_user_corporation_id = #{saasUserCorporationId}</if>
                                                                            <if test="requesterId != null "> and mt.requester_id = #{requesterId}</if>
                                                                            <if test="content != null  and content != ''"> and mt.content = #{content}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="createdBy != null "> and mt.created_by = #{createdBy}</if>
                                                                            <if test="deletedAt != null "> and mt.deleted_at = #{deletedAt}</if>
                                                                            <if test="deletedBy != null "> and mt.deleted_by = #{deletedBy}</if>
                                                                            <if test="deleted != null "> and mt.deleted = #{deleted}</if>
