                                        </where>
    </select>

    <insert id="insertAuditLog" parameterType="com.games.payment.domain.AuditLog" useGeneratedKeys="true" keyProperty="id">
        insert into audit_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
