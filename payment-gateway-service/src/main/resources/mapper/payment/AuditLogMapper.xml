                                                                <if test="deleted != null">#{deleted},</if>
                                                                <if test="remark != null">#{remark},</if>
                                                                <if test="action != null">#{action},</if>
                                    </trim>
    </insert>

    <update id="updateAuditLog" parameterType="com.games.payment.domain.AuditLog">
        update audit_log
        <trim prefix="SET" suffixOverrides=",">
