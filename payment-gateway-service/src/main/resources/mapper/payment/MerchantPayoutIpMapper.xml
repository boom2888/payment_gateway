<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.MerchantPayoutIpMapper">

    <resultMap type="com.games.payment.domain.MerchantPayoutIp" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="merchantId"    column="merchant_id"    />
                    <result property="payoutIps"    column="payout_ips"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="updatedAt"    column="updated_at"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.merchant_id, mt.payout_ips, mt.created_at, mt.updated_at    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.MerchantPayoutIp" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from merchant_payout_ip mt
        <where>

                                                        <if test="id != null  and id != ''"> and mt.id = #{id}</if>
                                                                            <if test="merchantId != null  and merchantId != ''"> and mt.merchant_id = #{merchantId}</if>
                                                                            <if test="payoutIps != null  and payoutIps != ''"> and mt.payout_ips = #{payoutIps}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="updatedAt != null "> and mt.updated_at = #{updatedAt}</if>
                                        </where>
    </select>

    <insert id="insertMerchantPayoutIp" parameterType="com.games.payment.domain.MerchantPayoutIp" useGeneratedKeys="true" keyProperty="id">
        insert into merchant_payout_ip
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="merchantId != null and merchantId != ''">merchant_id,</if>
                                                                <if test="payoutIps != null and payoutIps != ''">payout_ips,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="updatedAt != null">updated_at,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="merchantId != null and merchantId != ''">#{merchantId},</if>
                                                                <if test="payoutIps != null and payoutIps != ''">#{payoutIps},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="updatedAt != null">#{updatedAt},</if>
                                    </trim>
    </insert>

    <update id="updateMerchantPayoutIp" parameterType="com.games.payment.domain.MerchantPayoutIp">
        update merchant_payout_ip
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="merchantId != null and merchantId != ''">merchant_id = #{merchantId},</if>
                                                                <if test="payoutIps != null and payoutIps != ''">payout_ips = #{payoutIps},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="updatedAt != null">updated_at = #{updatedAt},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantPayoutIpById" parameterType="String">
        delete from merchant_payout_ip where id = #{id}
    </delete>

    <delete id="deleteMerchantPayoutIpByIds" parameterType="String">
        delete from merchant_payout_ip where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>