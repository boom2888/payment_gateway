<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.WhiteUploadRecordMapper">

    <resultMap type="com.games.payment.domain.WhiteUploadRecord" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="fileName"    column="file_name"    />
                    <result property="updateNumber"    column="update_number"    />
                    <result property="status"    column="status"    />
                    <result property="createdAt"    column="created_at"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.file_name, mt.update_number, mt.status, mt.created_at    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.WhiteUploadRecord" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from white_upload_record mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="fileName != null  and fileName != ''"> and mt.file_name like concat('%', #{fileName}, '%')</if>
                                                                            <if test="updateNumber != null "> and mt.update_number = #{updateNumber}</if>
                                                                            <if test="status != null "> and mt.status = #{status}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                        </where>
    </select>

    <insert id="insertWhiteUploadRecord" parameterType="com.games.payment.domain.WhiteUploadRecord" useGeneratedKeys="true" keyProperty="id">
        insert into white_upload_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="fileName != null">file_name,</if>
                                                                <if test="updateNumber != null">update_number,</if>
                                                                <if test="status != null">status,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="fileName != null">#{fileName},</if>
                                                                <if test="updateNumber != null">#{updateNumber},</if>
                                                                <if test="status != null">#{status},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                    </trim>
    </insert>

    <update id="updateWhiteUploadRecord" parameterType="com.games.payment.domain.WhiteUploadRecord">
        update white_upload_record
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="fileName != null">file_name = #{fileName},</if>
                                                                <if test="updateNumber != null">update_number = #{updateNumber},</if>
                                                                <if test="status != null">status = #{status},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteWhiteUploadRecordById" parameterType="Long">
        delete from white_upload_record where id = #{id}
    </delete>

    <delete id="deleteWhiteUploadRecordByIds" parameterType="String">
        delete from white_upload_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>