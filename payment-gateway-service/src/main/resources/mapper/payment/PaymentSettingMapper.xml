<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.PaymentSettingMapper">

    <resultMap type="com.games.payment.domain.PaymentSetting" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="key"    column="key"    />
                    <result property="value"    column="value"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="updatedAt"    column="updated_at"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.key, mt.value, mt.created_at, mt.updated_at    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.PaymentSetting" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from payment_setting mt
        <where>

                                                        <if test="id != null  and id != ''"> and mt.id = #{id}</if>
                                                                            <if test="key != null  and key != ''"> and mt.key = #{key}</if>
                                                                            <if test="value != null  and value != ''"> and mt.value = #{value}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="updatedAt != null "> and mt.updated_at = #{updatedAt}</if>
                                        </where>
    </select>

    <insert id="insertPaymentSetting" parameterType="com.games.payment.domain.PaymentSetting" useGeneratedKeys="true" keyProperty="id">
        insert into payment_setting
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="key != null and key != ''">key,</if>
                                                                <if test="value != null and value != ''">value,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="updatedAt != null">updated_at,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="key != null and key != ''">#{key},</if>
                                                                <if test="value != null and value != ''">#{value},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="updatedAt != null">#{updatedAt},</if>
                                    </trim>
    </insert>

    <update id="updatePaymentSetting" parameterType="com.games.payment.domain.PaymentSetting">
        update payment_setting
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="key != null and key != ''">key = #{key},</if>
                                                                <if test="value != null and value != ''">value = #{value},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="updatedAt != null">updated_at = #{updatedAt},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deletePaymentSettingById" parameterType="String">
        delete from payment_setting where id = #{id}
    </delete>

    <delete id="deletePaymentSettingByIds" parameterType="String">
        delete from payment_setting where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>