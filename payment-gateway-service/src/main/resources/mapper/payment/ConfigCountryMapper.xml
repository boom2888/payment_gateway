<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ConfigCountryMapper">

    <resultMap type="com.games.payment.domain.ConfigCountry" id="BaseResultMap">
                    <result property="code"    column="code"    />
                    <result property="name"    column="name"    />
                    <result property="fullName"    column="full_name"    />
                    <result property="iso3"    column="iso3"    />
                    <result property="number"    column="number"    />
                    <result property="continentCode"    column="continent_code"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.code, mt.name, mt.full_name, mt.iso3, mt.number, mt.continent_code    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ConfigCountry" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from config_country mt
        <where>

                                                        <if test="code != null  and code != ''"> and mt.code = #{code}</if>
                                                                            <if test="name != null  and name != ''"> and mt.name like concat('%', #{name}, '%')</if>
                                                                            <if test="fullName != null  and fullName != ''"> and mt.full_name like concat('%', #{fullName}, '%')</if>
                                                                            <if test="iso3 != null  and iso3 != ''"> and mt.iso3 = #{iso3}</if>
                                                                            <if test="number != null  and number != ''"> and mt.number = #{number}</if>
                                                                            <if test="continentCode != null  and continentCode != ''"> and mt.continent_code = #{continentCode}</if>
                                        </where>
    </select>

    <insert id="insertConfigCountry" parameterType="com.games.payment.domain.ConfigCountry">
        insert into config_country
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                <if test="code != null">code,</if>
                                                                <if test="name != null and name != ''">name,</if>
                                                                <if test="fullName != null and fullName != ''">full_name,</if>
                                                                <if test="iso3 != null and iso3 != ''">iso3,</if>
                                                                <if test="number != null and number != ''">number,</if>
                                                                <if test="continentCode != null and continentCode != ''">continent_code,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                <if test="code != null">#{code},</if>
                                                                <if test="name != null and name != ''">#{name},</if>
                                                                <if test="fullName != null and fullName != ''">#{fullName},</if>
                                                                <if test="iso3 != null and iso3 != ''">#{iso3},</if>
                                                                <if test="number != null and number != ''">#{number},</if>
                                                                <if test="continentCode != null and continentCode != ''">#{continentCode},</if>
                                    </trim>
    </insert>

    <update id="updateConfigCountry" parameterType="com.games.payment.domain.ConfigCountry">
        update config_country
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="name != null and name != ''">name = #{name},</if>
                                                                <if test="fullName != null and fullName != ''">full_name = #{fullName},</if>
                                                                <if test="iso3 != null and iso3 != ''">iso3 = #{iso3},</if>
                                                                <if test="number != null and number != ''">number = #{number},</if>
                                                                <if test="continentCode != null and continentCode != ''">continent_code = #{continentCode},</if>
                                    </trim>
        where code = #{code}
    </update>

    <delete id="deleteConfigCountryByCode" parameterType="String">
        delete from config_country where code = #{code}
    </delete>

    <delete id="deleteConfigCountryByCodes" parameterType="String">
        delete from config_country where code in
        <foreach item="code" collection="array" open="(" separator="," close=")">
            #{code}
        </foreach>
    </delete>
    </mapper>