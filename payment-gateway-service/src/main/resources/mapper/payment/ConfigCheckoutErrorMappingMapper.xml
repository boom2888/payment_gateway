<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ConfigCheckoutErrorMappingMapper">

    <resultMap type="com.games.payment.domain.ConfigCheckoutErrorMapping" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="code"    column="code"    />
                    <result property="message"    column="message"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.code, mt.message    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ConfigCheckoutErrorMapping" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from config_checkout_error_mapping mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="code != null  and code != ''"> and mt.code = #{code}</if>
                                                                            <if test="message != null  and message != ''"> and mt.message = #{message}</if>
                                        </where>
    </select>

    <insert id="insertConfigCheckoutErrorMapping" parameterType="com.games.payment.domain.ConfigCheckoutErrorMapping" useGeneratedKeys="true" keyProperty="id">
        insert into config_checkout_error_mapping
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="code != null">code,</if>
                                                                <if test="message != null">message,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="code != null">#{code},</if>
                                                                <if test="message != null">#{message},</if>
                                    </trim>
    </insert>

    <update id="updateConfigCheckoutErrorMapping" parameterType="com.games.payment.domain.ConfigCheckoutErrorMapping">
        update config_checkout_error_mapping
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="code != null">code = #{code},</if>
                                                                <if test="message != null">message = #{message},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigCheckoutErrorMappingById" parameterType="Long">
        delete from config_checkout_error_mapping where id = #{id}
    </delete>

    <delete id="deleteConfigCheckoutErrorMappingByIds" parameterType="String">
        delete from config_checkout_error_mapping where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>