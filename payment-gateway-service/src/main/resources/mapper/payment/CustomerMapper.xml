                                                                <if test="saasUserCorporationId != null">saas_user_corporation_id = #{saasUserCorporationId},</if>
                                                                <if test="type != null">type = #{type},</if>
                                                                <if test="manager != null">manager = #{manager},</if>
                                                                <if test="subscriptionModelId != null">subscription_model_id = #{subscriptionModelId},</if>
                                                                <if test="riskLevel != null">risk_level = #{riskLevel},</if>
                                                                <if test="idRef != null">id_ref = #{idRef},</if>
