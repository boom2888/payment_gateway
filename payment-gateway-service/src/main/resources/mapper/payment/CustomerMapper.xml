                                                                <if test="saasUserCorporationId != null">#{saasUserCorporationId},</if>
                                                                <if test="type != null">#{type},</if>
                                                                <if test="manager != null">#{manager},</if>
                                                                <if test="subscriptionModelId != null">#{subscriptionModelId},</if>
                                                                <if test="riskLevel != null">#{riskLevel},</if>
