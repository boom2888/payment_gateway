    <sql id="Base_Column_List">
         mt.id, mt.user_id, mt.saas_user_corporation_id, mt.type, mt.manager, mt.subscription_model_id, mt.risk_level, mt.id_ref, mt.vip_id, mt.merchant_id, mt.sso_customer_id, mt.created_at, mt.created_by, mt.deleted_at, mt.deleted_by, mt.deleted, mt.remark, mt.fireblocks_vault_account_id, mt.sum90_day, mt.referral_code    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.Customer" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from customer mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="userId != null "> and mt.user_id = #{userId}</if>
                                                                            <if test="saasUserCorporationId != null "> and mt.saas_user_corporation_id = #{saasUserCorporationId}</if>
                                                                            <if test="type != null "> and mt.type = #{type}</if>
                                                                            <if test="manager != null "> and mt.manager = #{manager}</if>
                                                                            <if test="subscriptionModelId != null "> and mt.subscription_model_id = #{subscriptionModelId}</if>
                                                                            <if test="riskLevel != null "> and mt.risk_level = #{riskLevel}</if>
                                                                            <if test="idRef != null  and idRef != ''"> and mt.id_ref = #{idRef}</if>
                                                                            <if test="vipId != null "> and mt.vip_id = #{vipId}</if>
                                                                            <if test="merchantId != null "> and mt.merchant_id = #{merchantId}</if>
                                                                            <if test="ssoCustomerId != null  and ssoCustomerId != ''"> and mt.sso_customer_id = #{ssoCustomerId}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="createdBy != null "> and mt.created_by = #{createdBy}</if>
                                                                            <if test="deletedAt != null "> and mt.deleted_at = #{deletedAt}</if>
                                                                            <if test="deletedBy != null "> and mt.deleted_by = #{deletedBy}</if>
                                                                            <if test="deleted != null "> and mt.deleted = #{deleted}</if>
                                                                            <if test="remark != null  and remark != ''"> and mt.remark = #{remark}</if>
                                                                            <if test="fireblocksVaultAccountId != null  and fireblocksVaultAccountId != ''"> and mt.fireblocks_vault_account_id = #{fireblocksVaultAccountId}</if>
                                                                            <if test="sum90Day != null "> and mt.sum90_day = #{sum90Day}</if>
                                                                            <if test="referralCode != null  and referralCode != ''"> and mt.referral_code = #{referralCode}</if>
                                        </where>
    </select>
    <select id="selectCustomerWithUser" resultType="com.games.pay.dto.CustomerWithUserDto">
        select
        <include refid="Base_Column_List"/>,u.display_name
        from customer mt left join user u on mt.user_id = u.id
    </select>

