<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.PayoutInfoMapper">

    <resultMap type="com.games.payment.domain.PayoutInfo" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="orderId"    column="order_id"    />
                    <result property="processingFee"    column="processing_fee"    />
                    <result property="deductPayoutAmount"    column="deduct_payout_amount"    />
                    <result property="deductFee"    column="deduct_fee"    />
                    <result property="deductRate"    column="deduct_rate"    />
                    <result property="merchantCurrencyId"    column="merchant_currency_id"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="updatedAt"    column="updated_at"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.order_id, mt.processing_fee, mt.deduct_payout_amount, mt.deduct_fee, mt.deduct_rate, mt.merchant_currency_id, mt.created_at, mt.updated_at    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.PayoutInfo" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from payout_info mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="orderId != null "> and mt.order_id = #{orderId}</if>
                                                                            <if test="processingFee != null "> and mt.processing_fee = #{processingFee}</if>
                                                                            <if test="deductPayoutAmount != null "> and mt.deduct_payout_amount = #{deductPayoutAmount}</if>
                                                                            <if test="deductFee != null "> and mt.deduct_fee = #{deductFee}</if>
                                                                            <if test="deductRate != null "> and mt.deduct_rate = #{deductRate}</if>
                                                                            <if test="merchantCurrencyId != null "> and mt.merchant_currency_id = #{merchantCurrencyId}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="updatedAt != null "> and mt.updated_at = #{updatedAt}</if>
                                        </where>
    </select>

    <insert id="insertPayoutInfo" parameterType="com.games.payment.domain.PayoutInfo" useGeneratedKeys="true" keyProperty="id">
        insert into payout_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="orderId != null">order_id,</if>
                                                                <if test="processingFee != null">processing_fee,</if>
                                                                <if test="deductPayoutAmount != null">deduct_payout_amount,</if>
                                                                <if test="deductFee != null">deduct_fee,</if>
                                                                <if test="deductRate != null">deduct_rate,</if>
                                                                <if test="merchantCurrencyId != null">merchant_currency_id,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="updatedAt != null">updated_at,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="orderId != null">#{orderId},</if>
                                                                <if test="processingFee != null">#{processingFee},</if>
                                                                <if test="deductPayoutAmount != null">#{deductPayoutAmount},</if>
                                                                <if test="deductFee != null">#{deductFee},</if>
                                                                <if test="deductRate != null">#{deductRate},</if>
                                                                <if test="merchantCurrencyId != null">#{merchantCurrencyId},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="updatedAt != null">#{updatedAt},</if>
                                    </trim>
    </insert>

    <update id="updatePayoutInfo" parameterType="com.games.payment.domain.PayoutInfo">
        update payout_info
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="orderId != null">order_id = #{orderId},</if>
                                                                <if test="processingFee != null">processing_fee = #{processingFee},</if>
                                                                <if test="deductPayoutAmount != null">deduct_payout_amount = #{deductPayoutAmount},</if>
                                                                <if test="deductFee != null">deduct_fee = #{deductFee},</if>
                                                                <if test="deductRate != null">deduct_rate = #{deductRate},</if>
                                                                <if test="merchantCurrencyId != null">merchant_currency_id = #{merchantCurrencyId},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="updatedAt != null">updated_at = #{updatedAt},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deletePayoutInfoById" parameterType="Long">
        delete from payout_info where id = #{id}
    </delete>

    <delete id="deletePayoutInfoByIds" parameterType="String">
        delete from payout_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>