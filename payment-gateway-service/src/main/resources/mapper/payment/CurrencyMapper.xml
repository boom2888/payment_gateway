<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.CurrencyMapper">

    <resultMap type="com.games.payment.domain.Currency" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="code"    column="code"    />
                    <result property="symbol"    column="symbol"    />
                    <result property="name"    column="name"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.code, mt.symbol, mt.name    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.Currency" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from currency mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="code != null  and code != ''"> and mt.code = #{code}</if>
                                                                            <if test="symbol != null  and symbol != ''"> and mt.symbol = #{symbol}</if>
                                                                            <if test="name != null  and name != ''"> and mt.name like concat('%', #{name}, '%')</if>
                                        </where>
    </select>

    <insert id="insertCurrency" parameterType="com.games.payment.domain.Currency" useGeneratedKeys="true" keyProperty="id">
        insert into currency
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="code != null and code != ''">code,</if>
                                                                <if test="symbol != null and symbol != ''">symbol,</if>
                                                                <if test="name != null">name,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="code != null and code != ''">#{code},</if>
                                                                <if test="symbol != null and symbol != ''">#{symbol},</if>
                                                                <if test="name != null">#{name},</if>
                                    </trim>
    </insert>

    <update id="updateCurrency" parameterType="com.games.payment.domain.Currency">
        update currency
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="code != null and code != ''">code = #{code},</if>
                                                                <if test="symbol != null and symbol != ''">symbol = #{symbol},</if>
                                                                <if test="name != null">name = #{name},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteCurrencyById" parameterType="Long">
        delete from currency where id = #{id}
    </delete>

    <delete id="deleteCurrencyByIds" parameterType="String">
        delete from currency where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>