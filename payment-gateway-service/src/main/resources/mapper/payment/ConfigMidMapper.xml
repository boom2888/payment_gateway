<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ConfigMidMapper">

    <resultMap type="com.games.payment.domain.ConfigMid" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="acquirerId"    column="acquirer_id"    />
                    <result property="midCode"    column="mid_code"    />
                    <result property="description"    column="description"    />
                    <result property="settlementCurrencyId"    column="settlement_currency_id"    />
                    <result property="settlementCurrencyType"    column="settlement_currency_type"    />
                    <result property="status"    column="status"    />
                    <result property="siteId"    column="site_id"    />
                    <result property="siteName"    column="site_name"    />
                    <result property="clientId"    column="client_id"    />
                    <result property="clientName"    column="client_name"    />
                    <result property="acquirerMerchantId"    column="acquirer_merchant_id"    />
                    <result property="type"    column="type"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.acquirer_id, mt.mid_code, mt.description, mt.settlement_currency_id, mt.settlement_currency_type, mt.status, mt.site_id, mt.site_name, mt.client_id, mt.client_name, mt.acquirer_merchant_id, mt.type    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ConfigMid" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from config_mid mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="acquirerId != null "> and mt.acquirer_id = #{acquirerId}</if>
                                                                            <if test="midCode != null  and midCode != ''"> and mt.mid_code = #{midCode}</if>
                                                                            <if test="description != null  and description != ''"> and mt.description = #{description}</if>
                                                                            <if test="settlementCurrencyId != null "> and mt.settlement_currency_id = #{settlementCurrencyId}</if>
                                                                            <if test="settlementCurrencyType != null "> and mt.settlement_currency_type = #{settlementCurrencyType}</if>
                                                                            <if test="status != null "> and mt.status = #{status}</if>
                                                                            <if test="siteId != null  and siteId != ''"> and mt.site_id = #{siteId}</if>
                                                                            <if test="siteName != null  and siteName != ''"> and mt.site_name like concat('%', #{siteName}, '%')</if>
                                                                            <if test="clientId != null  and clientId != ''"> and mt.client_id = #{clientId}</if>
                                                                            <if test="clientName != null  and clientName != ''"> and mt.client_name like concat('%', #{clientName}, '%')</if>
                                                                            <if test="acquirerMerchantId != null  and acquirerMerchantId != ''"> and mt.acquirer_merchant_id = #{acquirerMerchantId}</if>
                                                                            <if test="type != null "> and mt.type = #{type}</if>
                                        </where>
    </select>

    <insert id="insertConfigMid" parameterType="com.games.payment.domain.ConfigMid">
        insert into config_mid
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                <if test="id != null">id,</if>
                                                                <if test="acquirerId != null">acquirer_id,</if>
                                                                <if test="midCode != null and midCode != ''">mid_code,</if>
                                                                <if test="description != null">description,</if>
                                                                <if test="settlementCurrencyId != null">settlement_currency_id,</if>
                                                                <if test="settlementCurrencyType != null">settlement_currency_type,</if>
                                                                <if test="status != null">status,</if>
                                                                <if test="siteId != null">site_id,</if>
                                                                <if test="siteName != null">site_name,</if>
                                                                <if test="clientId != null">client_id,</if>
                                                                <if test="clientName != null">client_name,</if>
                                                                <if test="acquirerMerchantId != null">acquirer_merchant_id,</if>
                                                                <if test="type != null">type,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                <if test="id != null">#{id},</if>
                                                                <if test="acquirerId != null">#{acquirerId},</if>
                                                                <if test="midCode != null and midCode != ''">#{midCode},</if>
                                                                <if test="description != null">#{description},</if>
                                                                <if test="settlementCurrencyId != null">#{settlementCurrencyId},</if>
                                                                <if test="settlementCurrencyType != null">#{settlementCurrencyType},</if>
                                                                <if test="status != null">#{status},</if>
                                                                <if test="siteId != null">#{siteId},</if>
                                                                <if test="siteName != null">#{siteName},</if>
                                                                <if test="clientId != null">#{clientId},</if>
                                                                <if test="clientName != null">#{clientName},</if>
                                                                <if test="acquirerMerchantId != null">#{acquirerMerchantId},</if>
                                                                <if test="type != null">#{type},</if>
                                    </trim>
    </insert>

    <update id="updateConfigMid" parameterType="com.games.payment.domain.ConfigMid">
        update config_mid
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="acquirerId != null">acquirer_id = #{acquirerId},</if>
                                                                <if test="midCode != null and midCode != ''">mid_code = #{midCode},</if>
                                                                <if test="description != null">description = #{description},</if>
                                                                <if test="settlementCurrencyId != null">settlement_currency_id = #{settlementCurrencyId},</if>
                                                                <if test="settlementCurrencyType != null">settlement_currency_type = #{settlementCurrencyType},</if>
                                                                <if test="status != null">status = #{status},</if>
                                                                <if test="siteId != null">site_id = #{siteId},</if>
                                                                <if test="siteName != null">site_name = #{siteName},</if>
                                                                <if test="clientId != null">client_id = #{clientId},</if>
                                                                <if test="clientName != null">client_name = #{clientName},</if>
                                                                <if test="acquirerMerchantId != null">acquirer_merchant_id = #{acquirerMerchantId},</if>
                                                                <if test="type != null">type = #{type},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigMidById" parameterType="Long">
        delete from config_mid where id = #{id}
    </delete>

    <delete id="deleteConfigMidByIds" parameterType="String">
        delete from config_mid where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>