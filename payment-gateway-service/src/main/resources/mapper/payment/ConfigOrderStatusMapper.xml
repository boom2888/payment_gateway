<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ConfigOrderStatusMapper">

    <resultMap type="com.games.payment.domain.ConfigOrderStatus" id="BaseResultMap">
                    <result property="code"    column="code"    />
                    <result property="desc"    column="desc"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="createdBy"    column="created_by"    />
                    <result property="deletedAt"    column="deleted_at"    />
                    <result property="deletedBy"    column="deleted_by"    />
                    <result property="deleted"    column="deleted"    />
                    <result property="remark"    column="remark"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.code, mt.desc, mt.created_at, mt.created_by, mt.deleted_at, mt.deleted_by, mt.deleted, mt.remark    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ConfigOrderStatus" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from config_order_status mt
        <where>

                                                        <if test="code != null  and code != ''"> and mt.code = #{code}</if>
                                                                            <if test="desc != null  and desc != ''"> and mt.desc = #{desc}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="createdBy != null "> and mt.created_by = #{createdBy}</if>
                                                                            <if test="deletedAt != null "> and mt.deleted_at = #{deletedAt}</if>
                                                                            <if test="deletedBy != null "> and mt.deleted_by = #{deletedBy}</if>
                                                                            <if test="deleted != null "> and mt.deleted = #{deleted}</if>
                                                                            <if test="remark != null  and remark != ''"> and mt.remark = #{remark}</if>
                                        </where>
    </select>

    <insert id="insertConfigOrderStatus" parameterType="com.games.payment.domain.ConfigOrderStatus">
        insert into config_order_status
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                <if test="code != null and code != ''">code,</if>
                                                                <if test="desc != null">desc,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="createdBy != null">created_by,</if>
                                                                <if test="deletedAt != null">deleted_at,</if>
                                                                <if test="deletedBy != null">deleted_by,</if>
                                                                <if test="deleted != null">deleted,</if>
                                                                <if test="remark != null">remark,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                <if test="code != null and code != ''">#{code},</if>
                                                                <if test="desc != null">#{desc},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="createdBy != null">#{createdBy},</if>
                                                                <if test="deletedAt != null">#{deletedAt},</if>
                                                                <if test="deletedBy != null">#{deletedBy},</if>
                                                                <if test="deleted != null">#{deleted},</if>
                                                                <if test="remark != null">#{remark},</if>
                                    </trim>
    </insert>

    <update id="updateConfigOrderStatus" parameterType="com.games.payment.domain.ConfigOrderStatus">
        update config_order_status
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="desc != null">desc = #{desc},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="createdBy != null">created_by = #{createdBy},</if>
                                                                <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
                                                                <if test="deletedBy != null">deleted_by = #{deletedBy},</if>
                                                                <if test="deleted != null">deleted = #{deleted},</if>
                                                                <if test="remark != null">remark = #{remark},</if>
                                    </trim>
        where code = #{code}
    </update>

    <delete id="deleteConfigOrderStatusByCode" parameterType="String">
        delete from config_order_status where code = #{code}
    </delete>

    <delete id="deleteConfigOrderStatusByCodes" parameterType="String">
        delete from config_order_status where code in
        <foreach item="code" collection="array" open="(" separator="," close=")">
            #{code}
        </foreach>
    </delete>
    </mapper>