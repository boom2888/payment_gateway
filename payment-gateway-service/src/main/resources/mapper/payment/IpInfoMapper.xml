<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.IpInfoMapper">

    <resultMap type="com.games.payment.domain.IpInfo" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="ip"    column="ip"    />
                    <result property="value"    column="value"    />
                    <result property="status"    column="status"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateTime"    column="update_time"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.ip, mt.value, mt.status, mt.create_time, mt.update_time    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.IpInfo" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from ip_info mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="ip != null  and ip != ''"> and mt.ip = #{ip}</if>
                                                                            <if test="value != null  and value != ''"> and mt.value = #{value}</if>
                                                                            <if test="status != null  and status != ''"> and mt.status = #{status}</if>
                                                                            <if test="createTime != null "> and mt.create_time = #{createTime}</if>
                                                                            <if test="updateTime != null "> and mt.update_time = #{updateTime}</if>
                                        </where>
    </select>

    <insert id="insertIpInfo" parameterType="com.games.payment.domain.IpInfo" useGeneratedKeys="true" keyProperty="id">
        insert into ip_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="ip != null and ip != ''">ip,</if>
                                                                <if test="value != null">value,</if>
                                                                <if test="status != null">status,</if>
                                                                <if test="createTime != null">create_time,</if>
                                                                <if test="updateTime != null">update_time,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="ip != null and ip != ''">#{ip},</if>
                                                                <if test="value != null">#{value},</if>
                                                                <if test="status != null">#{status},</if>
                                                                <if test="createTime != null">#{createTime},</if>
                                                                <if test="updateTime != null">#{updateTime},</if>
                                    </trim>
    </insert>

    <update id="updateIpInfo" parameterType="com.games.payment.domain.IpInfo">
        update ip_info
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="ip != null and ip != ''">ip = #{ip},</if>
                                                                <if test="value != null">value = #{value},</if>
                                                                <if test="status != null">status = #{status},</if>
                                                                <if test="createTime != null">create_time = #{createTime},</if>
                                                                <if test="updateTime != null">update_time = #{updateTime},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteIpInfoById" parameterType="Long">
        delete from ip_info where id = #{id}
    </delete>

    <delete id="deleteIpInfoByIds" parameterType="String">
        delete from ip_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>