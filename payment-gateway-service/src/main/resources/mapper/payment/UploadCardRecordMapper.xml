<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.UploadCardRecordMapper">

    <resultMap type="com.games.payment.domain.UploadCardRecord" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="fileUrl"    column="file_url"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="state"    column="state"    />
                    <result property="type"    column="type"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.file_url, mt.created_at, mt.state, mt.type    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.UploadCardRecord" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from upload_card_record mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="fileUrl != null  and fileUrl != ''"> and mt.file_url = #{fileUrl}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="state != null "> and mt.state = #{state}</if>
                                                                            <if test="type != null "> and mt.type = #{type}</if>
                                        </where>
    </select>

    <insert id="insertUploadCardRecord" parameterType="com.games.payment.domain.UploadCardRecord" useGeneratedKeys="true" keyProperty="id">
        insert into upload_card_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="fileUrl != null">file_url,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="state != null">state,</if>
                                                                <if test="type != null">type,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="fileUrl != null">#{fileUrl},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="state != null">#{state},</if>
                                                                <if test="type != null">#{type},</if>
                                    </trim>
    </insert>

    <update id="updateUploadCardRecord" parameterType="com.games.payment.domain.UploadCardRecord">
        update upload_card_record
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="fileUrl != null">file_url = #{fileUrl},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="state != null">state = #{state},</if>
                                                                <if test="type != null">type = #{type},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteUploadCardRecordById" parameterType="Long">
        delete from upload_card_record where id = #{id}
    </delete>

    <delete id="deleteUploadCardRecordByIds" parameterType="String">
        delete from upload_card_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>