<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.CustomerAddressMapper">

    <resultMap type="com.games.payment.domain.CustomerAddress" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="customerId"    column="customer_id"    />
                    <result property="addressId"    column="address_id"    />
                    <result property="activated"    column="activated"    />
                    <result property="createdAt"    column="created_at"    />
                    <result property="createdBy"    column="created_by"    />
                    <result property="deletedAt"    column="deleted_at"    />
                    <result property="deletedBy"    column="deleted_by"    />
                    <result property="deleted"    column="deleted"    />
                    <result property="remark"    column="remark"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.customer_id, mt.address_id, mt.activated, mt.created_at, mt.created_by, mt.deleted_at, mt.deleted_by, mt.deleted, mt.remark    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.CustomerAddress" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from customer_address mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="customerId != null "> and mt.customer_id = #{customerId}</if>
                                                                            <if test="addressId != null "> and mt.address_id = #{addressId}</if>
                                                                            <if test="activated != null "> and mt.activated = #{activated}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="createdBy != null "> and mt.created_by = #{createdBy}</if>
                                                                            <if test="deletedAt != null "> and mt.deleted_at = #{deletedAt}</if>
                                                                            <if test="deletedBy != null "> and mt.deleted_by = #{deletedBy}</if>
                                                                            <if test="deleted != null "> and mt.deleted = #{deleted}</if>
                                                                            <if test="remark != null  and remark != ''"> and mt.remark = #{remark}</if>
                                        </where>
    </select>

    <insert id="insertCustomerAddress" parameterType="com.games.payment.domain.CustomerAddress" useGeneratedKeys="true" keyProperty="id">
        insert into customer_address
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="customerId != null">customer_id,</if>
                                                                <if test="addressId != null">address_id,</if>
                                                                <if test="activated != null">activated,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="createdBy != null">created_by,</if>
                                                                <if test="deletedAt != null">deleted_at,</if>
                                                                <if test="deletedBy != null">deleted_by,</if>
                                                                <if test="deleted != null">deleted,</if>
                                                                <if test="remark != null">remark,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="customerId != null">#{customerId},</if>
                                                                <if test="addressId != null">#{addressId},</if>
                                                                <if test="activated != null">#{activated},</if>
                                                                <if test="createdAt != null">#{createdAt},</if>
                                                                <if test="createdBy != null">#{createdBy},</if>
                                                                <if test="deletedAt != null">#{deletedAt},</if>
                                                                <if test="deletedBy != null">#{deletedBy},</if>
                                                                <if test="deleted != null">#{deleted},</if>
                                                                <if test="remark != null">#{remark},</if>
                                    </trim>
    </insert>

    <update id="updateCustomerAddress" parameterType="com.games.payment.domain.CustomerAddress">
        update customer_address
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="customerId != null">customer_id = #{customerId},</if>
                                                                <if test="addressId != null">address_id = #{addressId},</if>
                                                                <if test="activated != null">activated = #{activated},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="createdBy != null">created_by = #{createdBy},</if>
                                                                <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
                                                                <if test="deletedBy != null">deleted_by = #{deletedBy},</if>
                                                                <if test="deleted != null">deleted = #{deleted},</if>
                                                                <if test="remark != null">remark = #{remark},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteCustomerAddressById" parameterType="Long">
        delete from customer_address where id = #{id}
    </delete>

    <delete id="deleteCustomerAddressByIds" parameterType="String">
        delete from customer_address where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>