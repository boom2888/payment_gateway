<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ConfigRiskLevelMapper">

    <resultMap type="com.games.payment.domain.ConfigRiskLevel" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="name"    column="name"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.name    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ConfigRiskLevel" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from config_risk_level mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="name != null  and name != ''"> and mt.name like concat('%', #{name}, '%')</if>
                                        </where>
    </select>

    <insert id="insertConfigRiskLevel" parameterType="com.games.payment.domain.ConfigRiskLevel" useGeneratedKeys="true" keyProperty="id">
        insert into config_risk_level
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="name != null and name != ''">name,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="name != null and name != ''">#{name},</if>
                                    </trim>
    </insert>

    <update id="updateConfigRiskLevel" parameterType="com.games.payment.domain.ConfigRiskLevel">
        update config_risk_level
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="name != null and name != ''">name = #{name},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteConfigRiskLevelById" parameterType="Long">
        delete from config_risk_level where id = #{id}
    </delete>

    <delete id="deleteConfigRiskLevelByIds" parameterType="String">
        delete from config_risk_level where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>