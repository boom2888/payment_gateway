<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.games.payment.mapper.ReportDataRecordMapper">

    <resultMap type="com.games.payment.domain.ReportDataRecord" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="reference"    column="reference"    />
                    <result property="type"    column="type"    />
                    <result property="url"    column="url"    />
                    <result property="lineCount"    column="line_count"    />
                    <result property="status"    column="status"    />
                    <result property="createdTime"    column="created_time"    />
            </resultMap>

    
    <sql id="Base_Column_List">
         mt.id, mt.reference, mt.type, mt.url, mt.line_count, mt.status, mt.created_time    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.ReportDataRecord" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from report_data_record mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="reference != null  and reference != ''"> and mt.reference = #{reference}</if>
                                                                            <if test="type != null "> and mt.type = #{type}</if>
                                                                            <if test="url != null  and url != ''"> and mt.url = #{url}</if>
                                                                            <if test="lineCount != null "> and mt.line_count = #{lineCount}</if>
                                                                            <if test="status != null "> and mt.status = #{status}</if>
                                                                            <if test="createdTime != null "> and mt.created_time = #{createdTime}</if>
                                        </where>
    </select>

    <insert id="insertReportDataRecord" parameterType="com.games.payment.domain.ReportDataRecord" useGeneratedKeys="true" keyProperty="id">
        insert into report_data_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                                            <if test="reference != null">reference,</if>
                                                                <if test="type != null">type,</if>
                                                                <if test="url != null">url,</if>
                                                                <if test="lineCount != null">line_count,</if>
                                                                <if test="status != null">status,</if>
                                                                <if test="createdTime != null">created_time,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="reference != null">#{reference},</if>
                                                                <if test="type != null">#{type},</if>
                                                                <if test="url != null">#{url},</if>
                                                                <if test="lineCount != null">#{lineCount},</if>
                                                                <if test="status != null">#{status},</if>
                                                                <if test="createdTime != null">#{createdTime},</if>
                                    </trim>
    </insert>

    <update id="updateReportDataRecord" parameterType="com.games.payment.domain.ReportDataRecord">
        update report_data_record
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="reference != null">reference = #{reference},</if>
                                                                <if test="type != null">type = #{type},</if>
                                                                <if test="url != null">url = #{url},</if>
                                                                <if test="lineCount != null">line_count = #{lineCount},</if>
                                                                <if test="status != null">status = #{status},</if>
                                                                <if test="createdTime != null">created_time = #{createdTime},</if>
                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteReportDataRecordById" parameterType="Long">
        delete from report_data_record where id = #{id}
    </delete>

    <delete id="deleteReportDataRecordByIds" parameterType="String">
        delete from report_data_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>