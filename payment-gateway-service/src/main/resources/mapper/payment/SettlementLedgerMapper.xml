    <sql id="Base_Column_List">
         mt.id, mt.recon_id, mt.merchant_id, mt.settlement_amount, mt.chargebacks_refunds_amount, mt.rolling_reserve_deducted, mt.rolling_reserve_payout, mt.payout, mt.notes, mt.created_at, mt.created_by, mt.deleted_at, mt.deleted_by, mt.remark    </sql>

    <select id="selectAllList" parameterType="com.games.payment.domain.SettlementLedger" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from settlement_ledger mt
        <where>

                                                        <if test="id != null "> and mt.id = #{id}</if>
                                                                            <if test="reconId != null "> and mt.recon_id = #{reconId}</if>
                                                                            <if test="merchantId != null "> and mt.merchant_id = #{merchantId}</if>
                                                                            <if test="settlementAmount != null "> and mt.settlement_amount = #{settlementAmount}</if>
                                                                            <if test="chargebacksRefundsAmount != null "> and mt.chargebacks_refunds_amount = #{chargebacksRefundsAmount}</if>
                                                                            <if test="rollingReserveDeducted != null "> and mt.rolling_reserve_deducted = #{rollingReserveDeducted}</if>
                                                                            <if test="rollingReservePayout != null "> and mt.rolling_reserve_payout = #{rollingReservePayout}</if>
                                                                            <if test="payout != null "> and mt.payout = #{payout}</if>
                                                                            <if test="notes != null  and notes != ''"> and mt.notes = #{notes}</if>
                                                                            <if test="createdAt != null "> and mt.created_at = #{createdAt}</if>
                                                                            <if test="createdBy != null "> and mt.created_by = #{createdBy}</if>
                                                                            <if test="deletedAt != null "> and mt.deleted_at = #{deletedAt}</if>
                                                                            <if test="deletedBy != null "> and mt.deleted_by = #{deletedBy}</if>
                                                                            <if test="remark != null  and remark != ''"> and mt.remark = #{remark}</if>
                                        </where>
    </select>

    <insert id="insertSettlementLedger" parameterType="com.games.payment.domain.SettlementLedger" useGeneratedKeys="true" keyProperty="id">
        insert into settlement_ledger
        <trim prefix="(" suffix=")" suffixOverrides=",">
