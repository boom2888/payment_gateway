                                    </trim>
        where id = #{id}
    </update>

    <delete id="deleteSettlementLedgerById" parameterType="Long">
        delete from settlement_ledger where id = #{id}
    </delete>

    <delete id="deleteSettlementLedgerByIds" parameterType="String">
        delete from settlement_ledger where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>