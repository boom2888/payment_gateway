<mapper namespace="com.games.payment.mapper.SettlementLedgerMapper">

    <resultMap type="com.games.payment.domain.SettlementLedger" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="reconId"    column="recon_id"    />
                    <result property="merchantId"    column="merchant_id"    />
                    <result property="settlementAmount"    column="settlement_amount"    />
                    <result property="chargebacksRefundsAmount"    column="chargebacks_refunds_amount"    />
                    <result property="rollingReserveDeducted"    column="rolling_reserve_deducted"    />
