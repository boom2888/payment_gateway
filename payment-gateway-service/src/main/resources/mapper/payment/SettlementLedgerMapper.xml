                                                                <if test="createdBy != null">#{createdBy},</if>
                                                                <if test="deletedAt != null">#{deletedAt},</if>
                                                                <if test="deletedBy != null">#{deletedBy},</if>
                                                                <if test="remark != null">#{remark},</if>
                                    </trim>
    </insert>

    <update id="updateSettlementLedger" parameterType="com.games.payment.domain.SettlementLedger">
        update settlement_ledger
        <trim prefix="SET" suffixOverrides=",">
                                                                            <if test="reconId != null">recon_id = #{reconId},</if>
                                                                <if test="merchantId != null">merchant_id = #{merchantId},</if>
                                                                <if test="settlementAmount != null">settlement_amount = #{settlementAmount},</if>
                                                                <if test="chargebacksRefundsAmount != null">chargebacks_refunds_amount = #{chargebacksRefundsAmount},</if>
                                                                <if test="rollingReserveDeducted != null">rolling_reserve_deducted = #{rollingReserveDeducted},</if>
                                                                <if test="rollingReservePayout != null">rolling_reserve_payout = #{rollingReservePayout},</if>
                                                                <if test="payout != null">payout = #{payout},</if>
                                                                <if test="notes != null">notes = #{notes},</if>
                                                                <if test="createdAt != null">created_at = #{createdAt},</if>
                                                                <if test="createdBy != null">created_by = #{createdBy},</if>
                                                                <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
                                                                <if test="deletedBy != null">deleted_by = #{deletedBy},</if>
