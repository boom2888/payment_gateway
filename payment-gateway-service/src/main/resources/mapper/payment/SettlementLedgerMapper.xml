                                                                <if test="merchantId != null">merchant_id,</if>
                                                                <if test="settlementAmount != null">settlement_amount,</if>
                                                                <if test="chargebacksRefundsAmount != null">chargebacks_refunds_amount,</if>
                                                                <if test="rollingReserveDeducted != null">rolling_reserve_deducted,</if>
                                                                <if test="rollingReservePayout != null">rolling_reserve_payout,</if>
                                                                <if test="payout != null">payout,</if>
                                                                <if test="notes != null">notes,</if>
                                                                <if test="createdAt != null">created_at,</if>
                                                                <if test="createdBy != null">created_by,</if>
                                                                <if test="deletedAt != null">deleted_at,</if>
                                                                <if test="deletedBy != null">deleted_by,</if>
                                                                <if test="remark != null">remark,</if>
                                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                                                                            <if test="reconId != null">#{reconId},</if>
                                                                <if test="merchantId != null">#{merchantId},</if>
                                                                <if test="settlementAmount != null">#{settlementAmount},</if>
                                                                <if test="chargebacksRefundsAmount != null">#{chargebacksRefundsAmount},</if>
                                                                <if test="rollingReserveDeducted != null">#{rollingReserveDeducted},</if>
                                                                <if test="rollingReservePayout != null">#{rollingReservePayout},</if>
                                                                <if test="payout != null">#{payout},</if>
                                                                <if test="notes != null">#{notes},</if>
