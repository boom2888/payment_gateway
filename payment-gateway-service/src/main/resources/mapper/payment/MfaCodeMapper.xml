<mapper namespace="com.games.payment.mapper.MfaCodeMapper">

    <resultMap type="com.games.payment.domain.MfaCode" id="BaseResultMap">
                    <result property="id"    column="id"    />
                    <result property="userId"    column="user_id"    />
                    <result property="code"    column="code"    />
                    <result property="otpAscii"    column="otp_ascii"    />
                    <result property="otpHex"    column="otp_hex"    />
                    <result property="otpBase32"    column="otp_base_32"    />
                    <result property="otpAuthUrl"    column="otp_auth_url"    />
                    <result property="expireAt"    column="expire_at"    />
