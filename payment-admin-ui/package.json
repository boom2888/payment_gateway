    "dompurify": "3.4.12",
    "echarts": "5.5.1",
    "element-ui": "2.15.0",
    "file-saver": "2.0.4",
    "fuse.js": "6.4.3",
    "highlight.js": "10.4.1",
    "js-beautify": "1.13.0",
    "js-cookie": "2.2.1",
